# Paper ingest (GET-only; no order placement)
# CoinGlass is optional enrichment (liquidations / L/S). When unset, ingest uses
# Binance Futures public funding + open interest (no key).
# COINGLASS_API_KEY=
# CG-API-KEY=

# Market-safety gate (default on). FLAT + block enqueue when unsafe;
# kill-switch only on critical failures when enabled.
# JARVISE_MARKET_SAFETY=1
# JARVISE_MARKET_SAFETY_MAX_SPREAD_BPS=50
# JARVISE_MARKET_SAFETY_MIN_DEPTH_USD=25000
# JARVISE_MARKET_SAFETY_MAX_AGE_MIN=90
# JARVISE_MARKET_SAFETY_REQUIRE_MACRO=0

# Binance spot read-only balances (P3). Never commit real keys. No order APIs.
# HMAC:
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Or Ed25519/RSA (prefer over SECRET when both set): upload public PEM on Binance,
# keep private PEM on disk only (e.g. secrets/binance-ed25519-prv.pem, chmod 600).
# BINANCE_API_PRIVATE_KEY_PATH=/opt/jarvise/secrets/binance-ed25519-prv.pem
# BINANCE_API_PRIVATE_KEY_PASSPHRASE=

# P4-C live trade keys (spot trade only — no withdraw). Distinct from read keys.
# Leave unset unless JARVISE_LIVE_TRADING=true and owner has enabled live.
# BINANCE_TRADE_API_KEY=
# BINANCE_TRADE_API_SECRET=
# BINANCE_TRADE_PRIVATE_KEY_PATH=/opt/jarvise/secrets/binance-trade-ed25519-prv.pem
# BINANCE_TRADE_PRIVATE_KEY_PASSPHRASE=
# Optional sizing base when live (defaults to paper equity):
# JARVISE_LIVE_EQUITY_USD=10000

# Cursor ask-repo (scripts/ask-repo.ts) -- do not commit real keys
CURSOR_API_KEY=

# Background plane (docker compose)
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=jarvise_doctrine
N8N_HOST=localhost
N8N_PORT=5678
# false for Tailscale HTTP (http://TAILSCALE_IP:5678). Use true only behind TLS.
N8N_SECURE_COOKIE=false
N8N_BASIC_AUTH_USER=jarvise
N8N_BASIC_AUTH_PASSWORD=change-me
# n8n REST API key (Settings → API). Used by MCP / automation clients.
N8N_API_KEY=

# Hostinger prod — set to `tailscale ip -4` on the VPS
TAILSCALE_IP=

# OpenRouter (OpenClaw agent brain)
OPENROUTER_API_KEY=
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.9.5
OPENCLAW_PORT=18789
OPENCLAW_PAPER_ONLY=true
# Gateway auth token (openclaw devices / remote clients)
OPENCLAW_GATEWAY_TOKEN=

# OpenClaw MCP — paper/manual signal context only; disable live execution tools
# Prefer command (see mcp/jarvise-mcp.json.example): openclaw mcp serve --url ws://127.0.0.1:18789
OPENCLAW_MCP_COMMAND=openclaw
# Optional alternate: leave empty and use command+args in MCP JSON (recommended)
OPENCLAW_MCP_URL=

# Firecrawl (RAG allowlist scrape)
FIRECRAWL_API_KEY=
# FIRECRAWL_API_URL=https://api.firecrawl.dev/v1/scrape

# Control web (optional basic auth; Tailscale is primary perimeter)
WEB_PORT=8080
WEB_BASIC_AUTH_USER=
WEB_BASIC_AUTH_PASSWORD=

# NotebookLM sync (nlm profile)
NLM_PROFILE=chatoe
NLM_HOME=./data/nlm

# Optional embedding override for RAG indexer
# EMBEDDING_API_BASE=

JARVISE_PAPER_ONLY=true

# P4-C live submit on Approve. Default false — keep false on VPS until owner enables
# trade keys (spot only, no withdraw) + explicit ops step.
JARVISE_LIVE_TRADING=false

# Paper approval queue TTL (minutes); timeout marks timed_out + FLAT open positions
JARVISE_APPROVAL_TIMEOUT_MIN=60

# Risk caps (paper enforce; venue-agnostic). Conservative defaults for $10k start.
JARVISE_MAX_NOTIONAL_PER_ORDER=2000
JARVISE_MAX_DAILY_LOSS_USD=100
JARVISE_DRAWDOWN_LOCK_PCT=5

# Scheduled paper enqueue (jobs → jarvise paper run). Defaults match paper_core @ 4h.
JARVISE_PAPER_UNIVERSE=paper_core
JARVISE_PAPER_TIMEFRAME=4h
# Ingest-health alert: newest paper-timeframe candle closed more than N minutes ago → Telegram.
JARVISE_INGEST_HEALTH_MAX_AGE_MIN=60

# Internal jobs API (n8n → jobs:8090). Leave token empty on a private Docker network.
JARVISE_JOBS_TOKEN=
JOBS_PORT=8090
# Web → jobs for doctrine snippets on the recommendation card (docker network only).
JARVISE_JOBS_URL=http://jobs:8090

# Pending-approval Telegram alerts (§5.8b). Optional; soft-fail when unset.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
