# Paper ingest (GET-only; no order placement)
COINGLASS_API_KEY=

# Cursor ask-repo (scripts/ask-repo.ts) — do not commit real keys
CURSOR_API_KEY=

# Background plane (docker compose)
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
N8N_HOST=localhost
N8N_PORT=5678
N8N_BASIC_AUTH_USER=jarvise
N8N_BASIC_AUTH_PASSWORD=change-me

# OpenClaw MCP — paper/manual signal context only; disable live execution tools
OPENCLAW_MCP_COMMAND=
OPENCLAW_MCP_URL=
OPENCLAW_PAPER_ONLY=true

