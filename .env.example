# Paper ingest (GET-only; no order placement)
# CoinGlass is optional enrichment (liquidations / L/S). When unset, ingest uses
# Binance Futures public funding + open interest (no key).
# COINGLASS_API_KEY=

# CoinGecko macro (GET /api/v3/global). Demo/generic key → public host + x-cg-demo-api-key.
# Pro key → pro-api.coingecko.com + x-cg-pro-api-key. Unset → keyless public (rate-limited).
# COINGECKO_API_KEY=
# COINGECKO_DEMO_API_KEY=
# COINGECKO_PRO_API_KEY=

# Market-safety gate (default on). FLAT + block enqueue when unsafe;
# kill-switch only on critical failures when enabled.
# JARVISE_MARKET_SAFETY=1
# JARVISE_MARKET_SAFETY_MAX_SPREAD_BPS=50
# JARVISE_MARKET_SAFETY_MIN_DEPTH_USD=25000
# JARVISE_MARKET_SAFETY_MAX_AGE_MIN=90
# CoinGecko macro is optional by default — HTTP blips must not engage kill-switch.
# JARVISE_MARKET_SAFETY_REQUIRE_MACRO=0

# Binance spot read-only balances (P3). Never commit real keys. No order APIs.
# HMAC:
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Or Ed25519/RSA (prefer over SECRET when both set): upload public PEM on Binance,
# keep private PEM on disk only (e.g. secrets/binance-ed25519-prv.pem, chmod 600).
# BINANCE_API_PRIVATE_KEY_PATH=/opt/jarvise/secrets/binance-ed25519-prv.pem
# BINANCE_API_PRIVATE_KEY_PASSPHRASE=

# P4-C live trade keys (spot trade only — no withdraw). Distinct from read keys.
# Leave unset unless JARVISE_LIVE_TRADING=true and owner has enabled live.
# BINANCE_TRADE_API_KEY=
# BINANCE_TRADE_API_SECRET=
# BINANCE_TRADE_PRIVATE_KEY_PATH=/opt/jarvise/secrets/binance-trade-ed25519-prv.pem
# BINANCE_TRADE_PRIVATE_KEY_PASSPHRASE=
# Optional sizing base when live (defaults to paper equity):
# JARVISE_LIVE_EQUITY_USD=10000

# Cursor ask-repo (scripts/ask-repo.ts) -- do not commit real keys
CURSOR_API_KEY=

# Background plane (docker compose)
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=jarvise_doctrine
N8N_HOST=localhost
N8N_PORT=5678
# false for Tailscale HTTP (http://TAILSCALE_IP:5678). Use true only behind TLS.
N8N_SECURE_COOKIE=false
N8N_BASIC_AUTH_USER=jarvise
N8N_BASIC_AUTH_PASSWORD=change-me
# n8n REST API key (Settings → API). Used by MCP / automation clients.
N8N_API_KEY=

# Hostinger prod — set to `tailscale ip -4` on the VPS
TAILSCALE_IP=

# OpenRouter (OpenClaw agent brain)
OPENROUTER_API_KEY=
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.9.5
OPENCLAW_PORT=18789
OPENCLAW_PAPER_ONLY=true
# Gateway auth token (openclaw devices / remote clients)
OPENCLAW_GATEWAY_TOKEN=

# OpenClaw MCP — paper/manual signal context only; disable live execution tools
# Prefer command (see mcp/jarvise-mcp.json.example): openclaw mcp serve --url ws://127.0.0.1:18789
OPENCLAW_MCP_COMMAND=openclaw
# Optional alternate: leave empty and use command+args in MCP JSON (recommended)
OPENCLAW_MCP_URL=

# Firecrawl (RAG allowlist scrape)
FIRECRAWL_API_KEY=
# FIRECRAWL_API_URL=https://api.firecrawl.dev/v1/scrape

# Control web (optional basic auth; Tailscale is primary perimeter)
WEB_PORT=8080
WEB_BASIC_AUTH_USER=
WEB_BASIC_AUTH_PASSWORD=

# NotebookLM sync (nlm profile)
NLM_PROFILE=chatoe
NLM_HOME=./data/nlm

# Optional embedding override for RAG indexer
# EMBEDDING_API_BASE=

JARVISE_PAPER_ONLY=true

# P4-C live submit on Approve. Default false — keep false on VPS until owner enables
# trade keys (spot only, no withdraw) + explicit ops step.
JARVISE_LIVE_TRADING=false

# Paper approval queue TTL (minutes); timeout marks timed_out + FLAT open positions
JARVISE_APPROVAL_TIMEOUT_MIN=60

# Exchange venue (read-only balances). binance = primary; eterna = T2.5 stub (fixture or blocked).
# JARVISE_EXCHANGE_VENUE=binance
# ETERNA_SPOT_FIXTURE=/path/to/balances.json

# Risk caps (paper enforce; venue-agnostic). Conservative defaults for $10k start.
JARVISE_MAX_NOTIONAL_PER_ORDER=2000
JARVISE_MAX_DAILY_LOSS_USD=100
JARVISE_DRAWDOWN_LOCK_PCT=5
# Portfolio book limits (T2.2) — hard block without kill-switch on soft portfolio breach.
JARVISE_MAX_OPEN_POSITIONS=2
JARVISE_MAX_GROSS_NOTIONAL_PCT=10
JARVISE_MAX_SYMBOL_NOTIONAL_PCT=6
JARVISE_MAX_CORRELATED_BUCKET_PCT=10

# Scheduled paper enqueue (jobs → jarvise paper run). Defaults match paper_core @ 4h.
# Opt-in Freqtrade-style static whitelist (BTC ETH SOL BNB): set both
# JARVISE_PAPER_UNIVERSE=paper_liquid and
# JARVISE_INGEST_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT
# then one-shot 4h --since backfill for SOL/BNB (EMA200). Cap JARVISE_MAX_OPEN_POSITIONS stays 2
# unless you raise it on purpose. Floors 0.55/0.70 and same_side_hold unchanged.
JARVISE_PAPER_UNIVERSE=paper_core
# JARVISE_INGEST_SYMBOLS=BTCUSDT,ETHUSDT
JARVISE_PAPER_TIMEFRAME=4h
# Analyzer MTF (T2.3): require HTF regime to agree with LTF before directional size.
JARVISE_ANALYZE_MTF=true
JARVISE_ANALYZE_HTF=1d
# Paper fill fee in bps (default 10 = Binance spot taker, no BNB). Slip stays max(5 bps, half spread).
# JARVISE_PAPER_FEE_BPS=10
# US ETF / equity paper fee (Stooq SPY/QQQ); default 2 bps.
# JARVISE_PAPER_EQUITY_FEE_BPS=2
# GET retries for market-data providers + exchange reads (429/418/5xx/timeouts; honors Retry-After). Default 3.
# JARVISE_HTTP_RETRIES=3
# Provider circuit breaker: 5 consecutive exhausted failures → skip that provider 15 min (state in Redis when set).
# Jobs subprocess wall-clock limits (seconds); overlap is refused via Redis SET NX locks (jarvise:lock:<job>).
# JARVISE_JOB_TIMEOUT_INGEST_S=900
# JARVISE_JOB_TIMEOUT_PAPER_RUN_S=300
# JARVISE_JOB_TIMEOUT_PAPER_EXPIRE_S=120
# JARVISE_JOB_TIMEOUT_RAG_S=900

# Backups (infra/backup/backup.sh, root cron on the VPS). Off-box rsync target; leave empty to keep local only.
# JARVISE_BACKUP_DEST=user@backup-host:/backups/jarvise
# JARVISE_BACKUP_KEEP=14
# Ingest-health alert: newest paper-timeframe candle closed more than one interval + N minutes ago → Telegram.
JARVISE_INGEST_HEALTH_MAX_AGE_MIN=60

# Paper auto-decide (phase 1 of owner-controlled autonomy). Default OFF.
# When on: after each paper-run, Claude via OpenRouter (inside jobs) confirms / rejects / defers
# candidates that already passed Jarvise filters. Paper only — refuses when JARVISE_LIVE_TRADING=true.
JARVISE_PAPER_AUTO_DECIDE=false
JARVISE_AUTO_DECIDE_MODEL=anthropic/claude-sonnet-5.5
JARVISE_AUTO_DECIDE_MIN_CONF=0.55
JARVISE_AUTO_DECIDE_MAX_PER_RUN=4
JARVISE_AUTO_DECIDE_TIMEOUT_S=30
# Soft EV gate (T2.1): when set, auto-decide skips if 30d auto EV is below this with N>=MIN_EV_N.
# Empty = disabled. Example: 0 → require non-negative auto EV. Never auto-loosens risk.
# JARVISE_AUTO_DECIDE_MIN_EV=0
# JARVISE_AUTO_DECIDE_MIN_EV_N=10
# Reuses OPENROUTER_API_KEY above; missing key → every candidate is deferred to you.

# Internal jobs API (n8n → jobs:8090). Leave token empty on a private Docker network.
JARVISE_JOBS_TOKEN=
JOBS_PORT=8090
# Web → jobs for doctrine snippets on the recommendation card (docker network only).
JARVISE_JOBS_URL=http://jobs:8090

# Pending-approval Telegram alerts (§5.8b). Optional; soft-fail when unset.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
