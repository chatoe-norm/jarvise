{
  "env": {
    "vars": {
      "OPENROUTER_API_KEY": "${OPENROUTER_API_KEY}",
      "OPENCLAW_PAPER_ONLY": "true",
      "JARVISE_PAPER_ONLY": "true",
      "QDRANT_URL": "http://qdrant:6333",
      "REDIS_URL": "redis://redis:6379/0"
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "openrouter/openrouter/auto"
      },
      "models": {
        "openrouter/openrouter/auto": {}
      }
    }
  },
  "plugins": {
    "load": {
      "paths": ["/plugins/jarvise-openclaw"]
    },
    "entries": {
      "jarvise": {
        "enabled": true,
        "config": {
          "exportDir": "/home/node/.openclaw/exports",
          "paperOnly": true
        }
      }
    }
  },
  "_jarvise": {
    "paper_only": true,
    "no_order_placement": true,
    "export_dir": "/home/node/.openclaw/exports",
    "note": "Research/signal context only. Do not enable live execution tools. data/openclaw is Gateway state (~/.openclaw), not the agent workspace; write paper notes to export_dir for jarvise rag sync-openclaw."
  }
}
