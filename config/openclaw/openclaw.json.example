{
  "env": {
    "vars": {
      "OPENROUTER_API_KEY": "${OPENROUTER_API_KEY}",
      "OPENCLAW_PAPER_ONLY": "true",
      "JARVISE_PAPER_ONLY": "true",
      "JARVISE_GUARDRAILS_POLICY": "/opt/jarvise/config/guardrails.policy.json",
      "QDRANT_URL": "http://qdrant:6333",
      "REDIS_URL": "redis://redis:6379/0"
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "openrouter/openrouter/auto"
      },
      "models": {
        "openrouter/openrouter/auto": {},
        "anthropic/claude-sonnet-5": {},
        "anthropic/claude-sonnet-4.6": {},
        "anthropic/claude-opus-5.5": {},
        "deepseek/deepseek-v4.1-flash": {},
        "minimax/minimax-m3": {},
        "google/gemini-3.8-flash": {},
        "deepseek/deepseek-v4-pro": {},
        "openai/gpt-5.6-luna": {},
        "z-ai/glm-5.3-flash": {},
        "nvidia/nemotron-3-ultra-550b-a55b:free": {},
        "nvidia/nemotron-3-super:free": {}
      }
    },
    "entries": {
      "doctrine_judge": {
        "identity": {
          "name": "Doctrine Judge",
          "emoji": "⚖️",
          "theme": "doctrine"
        },
        "model": {
          "primary": "anthropic/claude-sonnet-5",
          "fallbacks": [
            "anthropic/claude-sonnet-4.6",
            "anthropic/claude-opus-5.5"
          ]
        },
        "temperature": 0.0,
        "description": "ยังไม่เชื่อมต่อ ตารางนี้ไม่ใช่ทีม OpenClaw"
      },
      "heartbeat_ingest": {
        "identity": {
          "name": "Heartbeat Ingest",
          "emoji": "💓",
          "theme": "ingest"
        },
        "model": {
          "primary": "deepseek/deepseek-v4.1-flash",
          "fallbacks": [
            "minimax/minimax-m3",
            "google/gemini-3.8-flash"
          ]
        },
        "temperature": 0.1,
        "description": "ยังไม่เชื่อมต่อ ตารางนี้ไม่ใช่ทีม OpenClaw"
      },
      "quant_analyzer": {
        "identity": {
          "name": "Quant Analyzer",
          "emoji": "📐",
          "theme": "quant"
        },
        "model": {
          "primary": "deepseek/deepseek-v4-pro",
          "fallbacks": [
            "openai/gpt-5.6-luna",
            "anthropic/claude-sonnet-5"
          ]
        },
        "temperature": 0.0,
        "description": "ยังไม่เชื่อมต่อ ตารางนี้ไม่ใช่ทีม OpenClaw"
      },
      "context_digest": {
        "identity": {
          "name": "Context Digest",
          "emoji": "📰",
          "theme": "context"
        },
        "model": {
          "primary": "google/gemini-3.8-flash",
          "fallbacks": [
            "z-ai/glm-5.3-flash",
            "deepseek/deepseek-v4.1-flash"
          ]
        },
        "temperature": 0.3,
        "description": "ยังไม่เชื่อมต่อ ตารางนี้ไม่ใช่ทีม OpenClaw"
      },
      "paper_sandbox": {
        "identity": {
          "name": "Paper Sandbox",
          "emoji": "🧪",
          "theme": "sandbox"
        },
        "model": {
          "primary": "nvidia/nemotron-3-ultra-550b-a55b:free",
          "fallbacks": [
            "nvidia/nemotron-3-super:free",
            "google/gemini-3.8-flash"
          ]
        },
        "temperature": 0.1,
        "description": "ยังไม่เชื่อมต่อ ตารางนี้ไม่ใช่ทีม OpenClaw"
      }
    }
  },
  "skills": {
    "load": {
      "extraDirs": ["/plugins/jarvise-openclaw/skills"]
    },
    "entries": {
      "claw-compactor": { "enabled": true }
    }
  }
}
