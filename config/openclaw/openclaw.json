{
  "env": {
    "vars": {
      "OPENROUTER_API_KEY": "${OPENROUTER_API_KEY}",
      "OPENCLAW_PAPER_ONLY": "true",
      "JARVISE_PAPER_ONLY": "true",
      "JARVISE_GUARDRAILS_POLICY": "/opt/jarvise/config/guardrails.policy.json",
      "QDRANT_URL": "http://qdrant:6333",
      "REDIS_URL": "redis://redis:6379/0"
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "openrouter/openrouter/auto"
      },
      "models": {
        "openrouter/openrouter/auto": {},
        "anthropic/claude-sonnet-5": {},
        "anthropic/claude-sonnet-4.6": {},
        "anthropic/claude-opus-5.5": {},
        "deepseek/deepseek-v4.1-flash": {},
        "minimax/minimax-m3": {},
        "google/gemini-3.8-flash": {},
        "deepseek/deepseek-v4-pro": {},
        "openai/gpt-5.6-luna": {},
        "z-ai/glm-5.3-flash": {},
        "nvidia/nemotron-3-ultra-550b-a55b:free": {},
        "nvidia/nemotron-3-super:free": {}
      }
    },
    "entries": {
      "doctrine_judge": {
        "identity": {
          "name": "Doctrine Judge",
          "emoji": "⚖️",
          "theme": "doctrine"
        },
        "model": {
          "primary": "anthropic/claude-sonnet-5",
          "fallbacks": [
            "anthropic/claude-sonnet-4.6",
            "anthropic/claude-opus-5.5"
          ]
        },
        "temperature": 0.0,
        "description": "ยังไม่เชื่อมต่อ ตารางนี้ไม่ใช่ทีม OpenClaw"
      },
      "heartbeat_ingest": {
        "identity": {
          "name": "Heartbeat Ingest",
          "emoji": "💓",
          "theme": "ingest"
        },
        "model": {
          "primary": "deepseek/deepseek-v4.1-flash",
          "fallbacks": [
            "minimax/minimax-m3",
            "google/gemini-3.8-flash"
          ]
        },
        "temperature": 0.1,
        "description": "ยังไม่เชื่อมต่อ ตารางนี้ไม่ใช่ทีม OpenClaw"
      },
      "quant_analyzer": {
        "identity": {
          "name": "Quant Analyzer",
          "emoji": "📐",
          "theme": "quant"
        },
        "model": {
          "primary": "deepseek/deepseek-v4-pro",
          "fallbacks": [
            "openai/gpt-5.6-luna",
            "anthropic/claude-sonnet-5"
          ]
        },
        "temperature": 0.0,
        "description": "ยังไม่เชื่อมต่อ ตารางนี้ไม่ใช่ทีม OpenClaw"
      },
      "context_digest": {
        "identity": {
          "name": "Context Digest",
          "emoji": "📰",
          "theme": "context"
        },
        "model": {
          "primary": "google/gemini-3.8-flash",
          "fallbacks": [
            "z-ai/glm-5.3-flash",
            "deepseek/deepseek-v4.1-flash"
          ]
        },
        "temperature": 0.3,
        "description": "ยังไม่เชื่อมต่อ ตารางนี้ไม่ใช่ทีม OpenClaw"
      },
      "paper_sandbox": {
        "identity": {
          "name": "Paper Sandbox",
          "emoji": "🧪",
          "theme": "sandbox"
        },
        "model": {
          "primary": "nvidia/nemotron-3-ultra-550b-a55b:free",
          "fallbacks": [
            "nvidia/nemotron-3-super:free",
            "google/gemini-3.8-flash"
          ]
        },
        "temperature": 0.1,
        "description": "ยังไม่เชื่อมต่อ ตารางนี้ไม่ใช่ทีม OpenClaw"
      }
    }
  },
  "skills": {
    "load": {
      "extraDirs": [
        "/plugins/jarvise-openclaw/skills"
      ]
    },
    "entries": {
      "jarvise-signal-analyzer": { "enabled": true },
      "jarvise-risk-guard": { "enabled": true },
      "jarvise-order-router": { "enabled": true },
      "crypto-market-intel": { "enabled": true },
      "blackswan": { "enabled": true },
      "secretclaw": { "enabled": true },
      "ggshield-scanner": { "enabled": true },
      "jarvise-paper-research": { "enabled": true },
      "jarvise-doctrine-rag": { "enabled": true },
      "jarvise-binance-intel": { "enabled": true },
      "jarvise-news-ingest": { "enabled": true },
      "claw-compactor": { "enabled": true }
    }
  },
  "mcpServers": {
    "tradingview": {
      "command": "uvx",
      "args": [
        "--python",
        "3.13",
        "--from",
        "tradingview-mcp-server",
        "tradingview-mcp"
      ],
      "env": {
        "JARVISE_PAPER_ONLY": "true",
        "NOTE": "Research overlay only — screener/MTF/chat backtest. Do not write OHLCV into jarvise.db or drive paper/live fills from TV signals alone."
      }
    },
    "cmc-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "cmc-mcp-server"
      ],
      "env": {
        "JARVISE_PAPER_ONLY": "true",
        "NOTE": "Market cap dominance, Fear & Greed Index, Altcoin Season Index"
      }
    },
    "coingecko": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.api.coingecko.com/mcp"
      ],
      "env": {
        "JARVISE_PAPER_ONLY": "true"
      }
    },
    "jarvise-qdrant": {
      "command": "uvx",
      "args": [
        "mcp-server-qdrant"
      ],
      "env": {
        "QDRANT_URL": "http://qdrant:6333",
        "COLLECTION_NAME": "jarvise_doctrine",
        "JARVISE_PAPER_ONLY": "true"
      }
    }
  }
}
