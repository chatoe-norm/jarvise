{
  "id": "jrvsAssistSignal4h",
  "name": "Jarvise assist signal",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "25 0,4,8,12,16,20 * * *"
            }
          ]
        }
      },
      "id": "cron-assist-signal",
      "name": "After paper-run slots",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://jobs:8090/jobs/assist-signal",
        "options": {
          "timeout": 360000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Jarvise-Token",
              "value": "__JARVISE_JOBS_TOKEN__"
            }
          ]
        }
      },
      "id": "http-assist-signal",
      "name": "POST assist signal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 0],
      "notes": "Read-only futures advice. Never places orders. Owner quiet mode does not suppress."
    }
  ],
  "connections": {
    "After paper-run slots": {
      "main": [
        [
          {
            "node": "POST assist signal",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Bangkok"
  },
  "meta": {
    "templateCredsSetupCompleted": false,
    "jarvise": {
      "paper_only": true,
      "no_order_placement": true,
      "import": "Render __JARVISE_JOBS_TOKEN__ with infra/docker/render-n8n-jobs-workflows.sh before import. Do not commit a real token."
    }
  },
  "pinData": {},
  "active": false
}
