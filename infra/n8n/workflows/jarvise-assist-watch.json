{
  "id": "jrvsAssistWatch5m",
  "name": "Jarvise assist watch",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/5 * * * *"
            }
          ]
        }
      },
      "id": "cron-assist-watch",
      "name": "Every 5 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://jobs:8090/jobs/assist-watch",
        "options": {
          "timeout": 360000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Jarvise-Token",
              "value": "__JARVISE_JOBS_TOKEN__"
            }
          ]
        }
      },
      "id": "http-assist-watch",
      "name": "POST assist watch",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 0],
      "notes": "Read-only position watch: no-stop, move-stop, exit. Never places orders."
    }
  ],
  "connections": {
    "Every 5 minutes": {
      "main": [
        [
          {
            "node": "POST assist watch",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Bangkok"
  },
  "meta": {
    "templateCredsSetupCompleted": false,
    "jarvise": {
      "paper_only": true,
      "no_order_placement": true,
      "import": "Render __JARVISE_JOBS_TOKEN__ with infra/docker/render-n8n-jobs-workflows.sh before import. Do not commit a real token."
    }
  },
  "pinData": {},
  "active": false
}
