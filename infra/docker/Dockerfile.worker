# syntax=docker/dockerfile:1
FROM python:3.12.14-slim-bookworm

ARG JARVISE_UID=1000
ARG JARVISE_GID=1000

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    JARVISE_PAPER_ONLY=true \
    PIP_NO_CACHE_DIR=1 \
    HOME=/home/jarvise \
    HF_HOME=/app/data/.cache/hf \
    NOTEBOOKLM_MCP_CLI_PATH=/home/jarvise/.nlm

RUN apt-get update && apt-get install -y --no-install-recommends \
      curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g "${JARVISE_GID}" jarvise \
    && useradd -m -u "${JARVISE_UID}" -g jarvise -s /usr/sbin/nologin jarvise

# Pinned + hashed runtime deps first (cache-friendly), then the editable package without deps.
COPY requirements/worker.lock ./requirements/worker.lock
RUN pip install --upgrade pip \
    && pip install --require-hashes -r requirements/worker.lock

COPY pyproject.toml README.md ./
COPY src ./src
COPY scripts ./scripts
COPY config ./config
COPY bin ./bin
RUN pip install --no-deps -e .

COPY infra/docker/worker-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh \
    && mkdir -p /app/data /home/jarvise/.nlm \
    && chown -R jarvise:jarvise /app /home/jarvise

USER jarvise
ENTRYPOINT ["/entrypoint.sh"]
CMD ["jarvise", "--help"]
