# syntax=docker/dockerfile:1

FROM node:22-bookworm-slim AS web-build
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM python:3.14.0-slim-bookworm

ARG JARVISE_UID=1000
ARG JARVISE_GID=1000

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    JARVISE_PAPER_ONLY=true \
    PIP_NO_CACHE_DIR=1 \
    HOME=/home/jarvise \
    JARVISE_WEB_DIST=/app/src/jarvise_web/static

RUN groupadd -g "${JARVISE_GID}" jarvise \
    && useradd -m -u "${JARVISE_UID}" -g jarvise -s /usr/sbin/nologin jarvise

COPY requirements/web.lock ./requirements/web.lock
RUN pip install --upgrade pip \
    && pip install --require-hashes -r requirements/web.lock

COPY pyproject.toml README.md ./
COPY src ./src
COPY --from=web-build /web/dist /app/src/jarvise_web/static
RUN pip install --no-deps -e . \
    && chown -R jarvise:jarvise /app

USER jarvise
EXPOSE 8080
CMD ["uvicorn", "jarvise_web.app:app", "--host", "0.0.0.0", "--port", "8080"]
