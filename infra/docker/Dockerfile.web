# syntax=docker/dockerfile:1
FROM python:3.12-slim-bookworm

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    JARVISE_PAPER_ONLY=true \
    PIP_NO_CACHE_DIR=1

COPY pyproject.toml README.md ./
COPY src ./src

RUN pip install --upgrade pip \
    && pip install -e . \
    && pip install 'fastapi>=0.115' 'uvicorn[standard]>=0.30' 'python-multipart>=0.0.9' 'redis>=5.0' 'httpx>=0.27' 'qdrant-client>=1.9'

EXPOSE 8080
CMD ["uvicorn", "jarvise_web.app:app", "--host", "0.0.0.0", "--port", "8080"]
