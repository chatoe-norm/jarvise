{
  "mcpServers": {
    "jarvise-redis": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-redis", "redis://localhost:6379"],
      "env": {
        "JARVISE_PAPER_ONLY": "true"
      }
    },
    "jarvise-qdrant": {
      "command": "uvx",
      "args": ["mcp-server-qdrant"],
      "env": {
        "QDRANT_URL": "http://localhost:6333",
        "COLLECTION_NAME": "jarvise_doctrine",
        "JARVISE_PAPER_ONLY": "true",
        "NOTE": "Doctrine RAG only — no order placement"
      }
    },
    "jarvise-n8n": {
      "command": "npx",
      "args": ["-y", "@n8n/mcp-server"],
      "env": {
        "N8N_API_URL": "http://localhost:5678",
        "N8N_API_KEY": "${N8N_API_KEY}",
        "JARVISE_PAPER_ONLY": "true"
      }
    },
    "openclaw": {
      "command": "${OPENCLAW_MCP_COMMAND}",
      "url": "${OPENCLAW_MCP_URL}",
      "env": {
        "OPENCLAW_PAPER_ONLY": "true",
        "OPENROUTER_API_KEY": "${OPENROUTER_API_KEY}",
        "JARVISE_GUARDRAIL": "Use OpenClaw for research/signal context only. Do not enable live execution tools until Jarvise manual-approval phase. No order placement from this MCP in paper mode. Prefer OpenRouter model openrouter/openrouter/auto."
      }
    }
  },
  "_jarvise": {
    "paper_only": true,
    "no_order_placement": true,
    "deploy": "On Hostinger VPS use docker internal URLs redis://redis:6379 and http://qdrant:6333; access UIs only via Tailscale.",
    "notes": [
      "Copy into Cursor MCP settings; replace ${...} placeholders.",
      "Prefer command OR url for openclaw — not both live at once.",
      "Write path remains: jarvise ingest → data/analytics/jarvise.db",
      "RAG path: jarvise rag refresh → Qdrant jarvise_doctrine"
    ]
  }
}
