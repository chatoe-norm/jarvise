{
  "mcpServers": {
    "jarvise-redis": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-redis", "redis://localhost:6379"],
      "env": {
        "JARVISE_PAPER_ONLY": "true"
      }
    },
    "jarvise-qdrant": {
      "command": "uvx",
      "args": ["mcp-server-qdrant"],
      "env": {
        "QDRANT_URL": "http://localhost:6333",
        "COLLECTION_NAME": "jarvise_doctrine",
        "JARVISE_PAPER_ONLY": "true",
        "NOTE": "Doctrine RAG only — no order placement"
      }
    },
    "jarvise-n8n": {
      "command": "npx",
      "args": ["-y", "@n8n/mcp-server"],
      "env": {
        "N8N_API_URL": "http://localhost:5678",
        "N8N_API_KEY": "${N8N_API_KEY}",
        "JARVISE_PAPER_ONLY": "true"
      }
    },
    "tradingview": {
      "command": "uvx",
      "args": [
        "--python",
        "3.13",
        "--from",
        "tradingview-mcp-server",
        "tradingview-mcp"
      ],
      "env": {
        "JARVISE_PAPER_ONLY": "true",
        "NOTE": "Research overlay only — screener/MTF/chat backtest. Do not write OHLCV into jarvise.db or drive paper/live fills from TV signals alone. Pin Python 3.13 (3.14 unsupported)."
      }
    },
    "coingecko": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://mcp.api.coingecko.com/mcp"],
      "env": {
        "JARVISE_PAPER_ONLY": "true",
        "NOTE": "Research overlay only — never silent-merge MCP into SQLite/paper. Numeric macro stays GET /api/v3/global via ingest. Map: docs/market-data/coingecko-for-jarvise.md"
      }
    },
    "coingecko-docs": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://docs.coingecko.com/mcp"],
      "env": {
        "JARVISE_PAPER_ONLY": "true",
        "NOTE": "Technical docs lookup only — do not index CoinGecko Learn into jarvise_doctrine"
      }
    },
    "openclaw": {
      "command": "openclaw",
      "args": [
        "mcp",
        "serve",
        "--url",
        "ws://127.0.0.1:18789"
      ],
      "env": {
        "OPENCLAW_PAPER_ONLY": "true",
        "OPENROUTER_API_KEY": "${OPENROUTER_API_KEY}",
        "OPENCLAW_GATEWAY_TOKEN": "${OPENCLAW_GATEWAY_TOKEN}",
        "JARVISE_GUARDRAIL": "Use OpenClaw for research/signal context only. Do not enable live execution tools until Jarvise manual-approval phase. No order placement from this MCP in paper mode. Prefer OpenRouter model openrouter/openrouter/auto. Add --token-file or rely on OPENCLAW_GATEWAY_TOKEN when the gateway requires auth."
      }
    }
  },
  "_jarvise": {
    "paper_only": true,
    "no_order_placement": true,
    "deploy": "On Hostinger VPS use docker internal URLs redis://redis:6379 and http://qdrant:6333; access UIs only via Tailscale.",
    "optional_overlays_not_enabled": {
      "eterna": {
        "type": "streamable-http",
        "url": "https://mcp.eterna.exchange/mcp",
        "env": {
          "JARVISE_PAPER_ONLY": "true",
          "NOTE": "Research overlay / future venue candidate only — kept OUT of mcpServers on purpose. OAuth scope mcp:full includes trading and withdrawal. If the owner enables it: use search_sdk / search_examples and execute_code read methods only (getTickers, getOrderbook, getInstruments, TA getters). Never placeOrder / closePosition / setLeverage / funding methods until docs/ops/live-enable-checklist.md is complete. Never write Eterna output into jarvise.db or the paper ledger. Map: docs/exchange/eterna-for-jarvise.md"
        }
      }
    },
    "notes": [
      "Copy into Cursor MCP settings; replace ${...} placeholders.",
      "OpenClaw MCP: local `openclaw mcp serve --url ws://127.0.0.1:18789` (gateway must be up). Prefer command over OPENCLAW_MCP_URL.",
      "For a remote Tailscale gateway, change --url to ws://$TAILSCALE_IP:18789 and pass a token file.",
      "Write path remains: jarvise ingest → data/analytics/jarvise.db (venue-agnostic contract; Binance klines are the current default provider, not a forever lock)",
      "TradingView MCP (community tradingview-mcp-server): research overlay only — never silent-merge into market_technicals",
      "CoinGecko MCP / Docs MCP: research overlay only — never fill paper; do not enable Agent SKILL or x402",
      "RAG path: jarvise rag refresh → Qdrant jarvise_doctrine (includes sync-openclaw)",
      "OpenClaw paper notes: data/openclaw/exports → jarvise rag sync-openclaw"
    ]
  }
}
